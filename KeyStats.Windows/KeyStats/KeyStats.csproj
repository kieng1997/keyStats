<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 使用 .NET Framework 4.8：Windows 10/11 已预装，应用大小约 5-10 MB，开箱即用 -->
    <TargetFramework>net48</TargetFramework>
    <!-- 在 Debug 模式下显示控制台窗口，方便查看输出 -->
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <!-- .NET Framework 不支持 ImplicitUsings，需要显式 using -->
    <ImplicitUsings>disable</ImplicitUsings>
    <!--
      Explicit AnyCPU: WebView2's build targets then copy the x86, x64 and arm64 native
      WebView2Loader.dll into runtimes\<arch>\native instead of only the x86 one.
    -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>KeyStats</AssemblyName>
    <RootNamespace>KeyStats</RootNamespace>
    <Version>1.55</Version>
    <Authors>KeyStats</Authors>
    <Product>KeyStats</Product>
    <Description>Keyboard and mouse statistics tracker for Windows</Description>
    <LangVersion>10.0</LangVersion>
    <SyncServiceBaseUrl Condition="'$(SyncServiceBaseUrl)' == '' and '$(Configuration)' == 'Debug'">https://keystats-sync-staging.istiancz.workers.dev</SyncServiceBaseUrl>
    <SyncServiceBaseUrl Condition="'$(SyncServiceBaseUrl)' == ''"></SyncServiceBaseUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="1.1.0" />
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- System.Text.Json 需要单独安装包才能在 .NET Framework 4.8 中使用 -->
    <!-- 升级到 8.0.5 以修复 CVE-2024-30105 和 CVE-2024-43485 安全漏洞 -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SyncServiceBaseUrl</_Parameter1>
      <_Parameter2>$(SyncServiceBaseUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  
  <!-- .NET Framework 需要显式引用 Microsoft.CSharp 以支持 dynamic 类型 -->
  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\*.ico" />
    <EmbeddedResource Include="Resources\Icons\tray-icon.png" />
  </ItemGroup>

  <!--
    The desktop pet viewer is a static offline page served from a restricted virtual host.
    The vendor folder holds Live2D Cubism Components under their own licenses (see
    Resources\DesktopPet\vendor\VERSION.txt); they are not MIT-licensed.
  -->
  <ItemGroup>
    <Content Include="Resources\DesktopPet\**\*"
             Exclude="Resources\DesktopPet\vendor-src\**\*"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Strings.resx">
      <ManifestResourceName>KeyStats.Properties.Strings</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Strings.zh-Hans.resx">
      <ManifestResourceName>KeyStats.Properties.Strings.zh-Hans</ManifestResourceName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Strings.zh-Hant.resx">
      <ManifestResourceName>KeyStats.Properties.Strings.zh-Hant</ManifestResourceName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
