<UserControl x:Class="KeyStats.Views.Controls.MouseTotalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KeyStats.Views.Controls"
             xmlns:p="clr-namespace:KeyStats.Properties">
    <UserControl.Resources>
        <Style x:Key="MouseLabelName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="MouseLabelValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="MouseInBodyName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MouseInBodyValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" MaxWidth="330"
                 HorizontalAlignment="Center" VerticalAlignment="Top">
            <Canvas Width="264" Height="264">
                <Image Canvas.Left="64.2" Canvas.Top="4" Width="135.5" Height="256" Stretch="Uniform"
                       Source="{DynamicResource MouseImageSource}"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="Black"/>
                    </Image.Effect>
                </Image>
                <!-- Leader lines: each ends with a dot on the physical button it labels. -->
                <Path Stroke="{DynamicResource MouseIndicatorBrush}" StrokeThickness="1"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M60 102 L70 102 M60 138 L70 138 M141 55 L203 55"/>
                <Ellipse Canvas.Left="68.2" Canvas.Top="100.2" Width="3.6" Height="3.6"
                         Fill="{DynamicResource MouseIndicatorBrush}"/>
                <Ellipse Canvas.Left="68.2" Canvas.Top="136.2" Width="3.6" Height="3.6"
                         Fill="{DynamicResource MouseIndicatorBrush}"/>
                <Ellipse Canvas.Left="139.2" Canvas.Top="53.2" Width="3.6" Height="3.6"
                         Fill="{DynamicResource MouseIndicatorBrush}"/>
                <StackPanel Canvas.Left="0" Canvas.Top="87" Width="58">
                    <TextBlock Text="{x:Static p:Strings.Click_Forward}" Style="{StaticResource MouseLabelName}" TextAlignment="Right"/>
                    <TextBlock Text="{Binding HistorySideForwardClicks}" Style="{StaticResource MouseLabelValue}"
                               TextAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="0" Canvas.Top="123" Width="58">
                    <TextBlock Text="{x:Static p:Strings.Click_Back}" Style="{StaticResource MouseLabelName}" TextAlignment="Right"/>
                    <TextBlock Text="{Binding HistorySideBackClicks}" Style="{StaticResource MouseLabelValue}"
                               TextAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="207" Canvas.Top="40" Width="53">
                    <TextBlock Text="{x:Static p:Strings.Click_Middle}" Style="{StaticResource MouseLabelName}"/>
                    <TextBlock Text="{Binding HistoryMiddleClicks}" Style="{StaticResource MouseLabelValue}" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Canvas.Left="82.5" Canvas.Top="80" Width="43"
                           Text="{x:Static p:Strings.Click_Left}" Style="{StaticResource MouseInBodyName}"/>
                <Viewbox Canvas.Left="82.5" Canvas.Top="93" Width="43" Height="16" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding HistoryLeftClicks}" Style="{StaticResource MouseInBodyValue}"/>
                </Viewbox>
                <TextBlock Canvas.Left="138.5" Canvas.Top="80" Width="43"
                           Text="{x:Static p:Strings.Click_Right}" Style="{StaticResource MouseInBodyName}"/>
                <Viewbox Canvas.Left="138.5" Canvas.Top="93" Width="43" Height="16" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding HistoryRightClicks}" Style="{StaticResource MouseInBodyValue}"/>
                </Viewbox>
            </Canvas>
        </Viewbox>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SubtleFillBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0.5" CornerRadius="6" Padding="8,7">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{x:Static p:Strings.Stats_MouseDistance}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock Text="{Binding HistoryMouseDistance}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource SubtleFillBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0.5" CornerRadius="6" Padding="8,7">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74A;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{x:Static p:Strings.Stats_ScrollTotalDistance}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock Text="{Binding HistoryScrollDistance}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Viewbox>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="{DynamicResource SubtleFillBrush}"
                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0.5" CornerRadius="6" Padding="8,7">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="{x:Static p:Strings.Stats_ScrollRevolutions}" FontSize="10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" Margin="0,3,0,0">
                        <TextBlock Text="{Binding HistoryScrollRevolutions}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
