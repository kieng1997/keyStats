<UserControl x:Class="KeyStats.Views.Controls.MouseTotalsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KeyStats.Views.Controls"
             xmlns:p="clr-namespace:KeyStats.Properties">
    <UserControl.Resources>
        <Style x:Key="MouseLabelName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="MouseLabelValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="MouseInBodyName" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MouseInBodyValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Geometry x:Key="MouseShellGeometry">M219 46 C167 48 118 72 87 108 C73 139 71 171 73 211 C73 257 79 299 77 340 C75 387 67 437 68 489 C67 547 77 593 110 631 C140 663 178 676 221 677 C271 677 317 653 348 615 C375 581 384 536 382 485 C381 431 370 384 369 337 C369 293 378 249 377 207 C377 165 373 131 362 107 C330 72 280 50 230 46 Z</Geometry>
        <Geometry x:Key="MouseLeftButtonGeometry">M219 46 C168 48 120 72 88 105 C82 132 83 166 86 207 L94 314 Q95 328 108 329 L222 329 L222 218 C208 217 201 211 201 199 L201 137 C201 124 208 117 222 116 L222 59 Z</Geometry>
        <Geometry x:Key="MouseRightButtonGeometry">M230 46 C281 50 331 73 360 104 C367 140 365 183 363 219 L353 315 Q351 329 338 329 L227 329 L227 218 C241 217 248 211 248 199 L248 137 C248 124 240 117 227 116 L227 59 Z</Geometry>
        <Geometry x:Key="MouseWheelHousingGeometry">M222 115 C207 115 200 123 200 138 L200 198 C200 213 208 220 222 220 L227 220 C242 220 249 212 249 198 L249 138 C249 123 242 115 227 115 Z</Geometry>
        <Geometry x:Key="MouseWheelGeometry">M221 122 C214 122 211 129 211 139 L211 196 Q211 210 221 213 L227 213 Q237 210 237 196 L237 139 C237 128 234 122 227 122 Z</Geometry>
        <LinearGradientBrush x:Key="MouseShellLighting" StartPoint="0,0.4" EndPoint="1,0.4">
            <GradientStop Offset="0" Color="{DynamicResource MouseHighlightColor}"/>
            <GradientStop Offset="0.35" Color="{DynamicResource MouseClearColor}"/>
            <GradientStop Offset="0.72" Color="{DynamicResource MouseRimShadeColor}"/>
            <GradientStop Offset="1" Color="{DynamicResource MouseShadeColor}"/>
        </LinearGradientBrush>
        <RadialGradientBrush x:Key="MousePalmLighting" Center="0.33,0.39" GradientOrigin="0.33,0.39" RadiusX="0.72" RadiusY="0.72">
            <GradientStop Offset="0" Color="{DynamicResource MouseHighlightColor}"/>
            <GradientStop Offset="1" Color="{DynamicResource MouseClearColor}"/>
        </RadialGradientBrush>
        <LinearGradientBrush x:Key="MouseButtonLighting" StartPoint="0,0.1" EndPoint="1,0.65">
            <GradientStop Offset="0" Color="{DynamicResource MouseHighlightColor}"/>
            <GradientStop Offset="0.42" Color="{DynamicResource MouseClearColor}"/>
            <GradientStop Offset="1" Color="{DynamicResource MouseShadeColor}"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MouseBezelLighting" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Offset="0" Color="{DynamicResource MouseDeepShadeColor}"/>
            <GradientStop Offset="0.17" Color="{DynamicResource MouseHighlightColor}"/>
            <GradientStop Offset="0.3" Color="{DynamicResource MouseShadeColor}"/>
            <GradientStop Offset="0.72" Color="{DynamicResource MouseDeepShadeColor}"/>
            <GradientStop Offset="0.86" Color="{DynamicResource MouseHighlightColor}"/>
            <GradientStop Offset="1" Color="{DynamicResource MouseDeepShadeColor}"/>
        </LinearGradientBrush>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Viewbox Grid.Row="0" Stretch="Uniform" StretchDirection="Both" MaxWidth="330"
                 HorizontalAlignment="Center" VerticalAlignment="Top">
            <Canvas Width="264" Height="264">
                <Path Stroke="{DynamicResource MouseEdgeBrush}" StrokeThickness="0.8"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M60 105 L72 105 L82 110 M60 150 L80 150 M145 34 C165 18 184 16 207 16"/>
                <!-- SVG and WPF use the reference image's 419 x 700 coordinates. -->
                <Viewbox Canvas.Left="51" Canvas.Top="-14" Width="167.6" Height="280">
                    <Canvas Width="419" Height="700">
                        <Path Data="{StaticResource MouseShellGeometry}" Fill="{DynamicResource MouseShellBrush}"
                              Stroke="{DynamicResource MouseEdgeBrush}" StrokeThickness="0.7">
                            <Path.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25"
                                                  Color="{DynamicResource MouseShadowColor}"/>
                            </Path.Effect>
                        </Path>
                        <Path Data="{StaticResource MouseShellGeometry}" Fill="{StaticResource MouseShellLighting}"/>
                        <Path Data="{StaticResource MouseShellGeometry}" Fill="{StaticResource MousePalmLighting}" Opacity="0.35"/>
                        <Path Data="M81 245 C76 266 76 291 78 315 Q80 324 83 314 L87 263 Q87 247 81 245 Z M78 345 C74 365 74 394 77 422 Q80 434 83 422 L86 363 Q85 348 78 345 Z"
                              Fill="{DynamicResource MouseWheelBrush}" Opacity="0.65"/>
                        <Path Data="M80 247 C77 269 77 293 79 313 Q80 318 82 312 L85 263 Q85 251 80 247 Z M77 348 C76 369 76 398 78 420 Q80 426 81 418 L84 363 Q83 351 77 348 Z"
                              Fill="{DynamicResource MouseSideButtonBrush}" Stroke="{DynamicResource MouseEdgeBrush}" StrokeThickness="0.8"/>
                        <Path Data="M84 118 C80 168 86 245 94 316 Q96 331 109 331 L222 330 M366 118 C369 170 362 251 354 316 Q352 331 338 331 L226 330"
                              Stroke="{DynamicResource MouseWheelBrush}" StrokeThickness="2.3"/>
                        <Path Data="M222 58 L226 58 L226 330 L222 330 Z" Fill="{DynamicResource MouseWheelBrush}"/>
                        <Path Data="{StaticResource MouseLeftButtonGeometry}" Fill="{DynamicResource MouseButtonBrush}"/>
                        <Path Data="{StaticResource MouseLeftButtonGeometry}" Fill="{StaticResource MouseButtonLighting}" Opacity="0.26"/>
                        <Path Data="{StaticResource MouseRightButtonGeometry}" Fill="{DynamicResource MouseButtonBrush}"/>
                        <Path Data="{StaticResource MouseRightButtonGeometry}" Fill="{StaticResource MouseButtonLighting}" Opacity="0.26"/>
                        <Path Data="M99 332 Q152 335 220 333 M229 333 Q290 335 347 332"
                              Stroke="{DynamicResource MouseHighlightBrush}" StrokeThickness="1.5" Opacity="0.45"/>
                        <Path Data="{StaticResource MouseWheelHousingGeometry}" Fill="{DynamicResource MouseSideButtonBrush}"/>
                        <Path Data="{StaticResource MouseWheelHousingGeometry}" Fill="{StaticResource MouseBezelLighting}"/>
                        <Path Data="{StaticResource MouseWheelGeometry}" Fill="{DynamicResource MouseWheelBrush}"/>
                        <Path Data="M215 132 Q224 134 233 132 M214 136 Q224 138 234 136 M214 140 Q224 142 234 140 M214 144 Q224 146 234 144 M214 148 Q224 150 234 148 M214 152 Q224 154 234 152 M214 156 Q224 158 234 156 M214 160 Q224 162 234 160 M214 164 Q224 166 234 164 M214 168 Q224 170 234 168 M214 172 Q224 174 234 172 M214 176 Q224 178 234 176 M214 180 Q224 182 234 180 M214 184 Q224 186 234 184 M214 188 Q224 190 234 188 M214 192 Q224 194 234 192 M215 196 Q224 198 233 196 M216 200 Q224 202 232 200 M218 204 Q224 206 230 204"
                              Stroke="{DynamicResource MouseWheelAccentBrush}" StrokeThickness="0.7" Opacity="0.55"/>
                        <Path Data="M207 137 L207 198 M242 137 L242 198"
                              Stroke="{DynamicResource MouseHighlightBrush}" StrokeThickness="1.2" Opacity="0.65"/>
                        <Ellipse Canvas.Left="222.2" Canvas.Top="365.2" Width="4.6" Height="4.6"
                                 Fill="{DynamicResource MouseIndicatorBrush}"/>
                        <Path Data="M226 489 C206 489 191 504 191 524 C191 543 206 558 226 558 L226 544 C214 544 205 536 205 524 C205 512 214 503 226 503 Z M228 517 L258 517 L258 549 L243 549 L243 532 L228 532 Z"
                              Fill="{DynamicResource MouseWheelAccentBrush}" Opacity="0.52"/>
                    </Canvas>
                </Viewbox>
                <StackPanel Canvas.Left="0" Canvas.Top="87" Width="58">
                    <TextBlock Text="{x:Static p:Strings.Click_Forward}" Style="{StaticResource MouseLabelName}" TextAlignment="Right"/>
                    <TextBlock Text="{Binding HistorySideForwardClicks}" Style="{StaticResource MouseLabelValue}"
                               TextAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="0" Canvas.Top="135" Width="58">
                    <TextBlock Text="{x:Static p:Strings.Click_Back}" Style="{StaticResource MouseLabelName}" TextAlignment="Right"/>
                    <TextBlock Text="{Binding HistorySideBackClicks}" Style="{StaticResource MouseLabelValue}"
                               TextAlignment="Right" Margin="0,1,0,0"/>
                </StackPanel>
                <StackPanel Canvas.Left="211" Canvas.Top="2" Width="53">
                    <TextBlock Text="{x:Static p:Strings.Click_Middle}" Style="{StaticResource MouseLabelName}"/>
                    <TextBlock Text="{Binding HistoryMiddleClicks}" Style="{StaticResource MouseLabelValue}" Margin="0,1,0,0"/>
                </StackPanel>
                <TextBlock Canvas.Left="87" Canvas.Top="59" Width="43"
                           Text="{x:Static p:Strings.Click_Left}" Style="{StaticResource MouseInBodyName}"/>
                <Viewbox Canvas.Left="87" Canvas.Top="72" Width="43" Height="16" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding HistoryLeftClicks}" Style="{StaticResource MouseInBodyValue}"/>
                </Viewbox>
                <TextBlock Canvas.Left="151" Canvas.Top="59" Width="43"
                           Text="{x:Static p:Strings.Click_Right}" Style="{StaticResource MouseInBodyName}"/>
                <Viewbox Canvas.Left="151" Canvas.Top="72" Width="43" Height="16" Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock Text="{Binding HistoryRightClicks}" Style="{StaticResource MouseInBodyValue}"/>
                </Viewbox>
            </Canvas>
        </Viewbox>
        <Viewbox Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                 Stretch="Uniform" StretchDirection="DownOnly">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SubtleFillBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0.5" CornerRadius="6" Padding="9,7">
                    <controls:StatItemControl Icon="&#xE8AB;" Title="{x:Static p:Strings.Stats_MouseDistance}" Value="{Binding HistoryMouseDistance}"/>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SubtleFillBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0.5" CornerRadius="6" Padding="9,7">
                    <controls:StatItemControl Icon="&#xE74A;" Title="{x:Static p:Strings.Stats_ScrollDistance}" Value="{Binding HistoryScrollDistance}"/>
                </Border>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
