<Window x:Class="KeyStats.Views.FloatingStatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:KeyStats.Properties"
        Title="{x:Static p:Strings.FloatingStats_WindowTitle}"
        Width="348"
        Height="348"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        HorizontalContentAlignment="Stretch"
        VerticalContentAlignment="Stretch"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Border x:Name="RootBorder"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0"
            Cursor="SizeAll"
            SnapsToDevicePixels="True"
            MouseLeftButtonDown="RootBorder_MouseLeftButtonDown">
        <Grid>
            <!--
                The desktop pet replaces the old statistics strip. The statistics grids below are
                kept for reference but stay collapsed; their settings no longer apply.
            -->
            <Grid x:Name="DesktopPetHost" Margin="0"/>

            <Button x:Name="ChooseModelButton"
                    Panel.ZIndex="2"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Padding="12,6"
                    Content="选择模型"
                    Click="ChooseModelButton_Click"/>

            <TextBlock x:Name="DesktopPetErrorText"
                       Panel.ZIndex="2"
                       Visibility="Collapsed"
                       Margin="12"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>

            <Grid x:Name="SingleRowLayout" Visibility="Collapsed" IsHitTestVisible="False"
                  Margin="4,1"
                  HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="SinglePrimaryValueTextBlock"
                           Grid.Column="0"
                           Padding="6,0"
                           Text="{Binding PrimaryValue}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           ToolTip="{Binding PrimaryFullValue}"/>

                <Border Grid.Column="1"
                        Width="0.5"
                        Height="14"
                        Background="{DynamicResource DividerBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                <TextBlock x:Name="SingleSecondaryValueTextBlock"
                           Grid.Column="2"
                           Padding="6,0"
                           Text="{Binding SecondaryValue}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           ToolTip="{Binding SecondaryFullValue}"/>
            </Grid>

            <Grid x:Name="DoubleRowLayout" Margin="4,1" Visibility="Collapsed" IsHitTestVisible="False">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="DoublePrimaryValueTextBlock"
                           Grid.Row="0"
                           Padding="6,0"
                           Text="{Binding PrimaryValue}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           ToolTip="{Binding PrimaryFullValue}"/>

                <Border Grid.Row="1"
                        Margin="3,0"
                        Height="0.5"
                        Background="{DynamicResource DividerBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"/>

                <TextBlock x:Name="DoubleSecondaryValueTextBlock"
                           Grid.Row="2"
                           Padding="6,0"
                           Text="{Binding SecondaryValue}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Center"
                           ToolTip="{Binding SecondaryFullValue}"/>
            </Grid>
        </Grid>
    </Border>
</Window>
