<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DesktopPetSmoke</AssemblyName>
    <StartupObject>DesktopPetSmoke.Program</StartupObject>
    <StartupObject Condition="'$(PetCheck)' == 'InitializationHide'">DesktopPetSmoke.InitializationHideCheck</StartupObject>
    <RootNamespace>DesktopPetSmoke</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\KeyStats.Windows\KeyStats\KeyStats.csproj">
      <Private>true</Private>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\KeyStats.Windows\KeyStats\Resources\DesktopPet\**\*"
             Link="Resources\DesktopPet\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
